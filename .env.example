# Server-only. Never prefix with NEXT_PUBLIC_. Get a key at https://playground.twelvelabs.io/ (API Keys).
TWELVELABS_API_KEY=
# Optional: an existing TwelveLabs index to use. It must have a Marengo model with the "visual"
# model option ("audio" too for spoken-word search). Leave blank and the app creates one
# (marengo3.0, visual+audio, thumbnails) on the first upload and reuses it from then on.
TWELVELABS_INDEX_ID=
# Relative paths resolve from the project root. Keep outside public/.
DATA_DIR=./data
# Optional: lower the upload limit (in MB). The provider maximum is 4000 MB.
MAX_UPLOAD_MB=

# --- Online version (Vercel) only -------------------------------------------
# The sign-in password, at least 12 characters. Set it in Vercel, not here.
APP_PASSWORD=
# BLOB_READ_WRITE_TOKEN is added by Vercel when you connect a private Blob store.
# APP_MODE=session runs the online (one-time, signed-in) version locally for testing.
