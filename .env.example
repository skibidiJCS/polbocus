# Server-only. Never prefix with NEXT_PUBLIC_. Get a key at https://playground.twelvelabs.io/ (API Keys).
TWELVELABS_API_KEY=
# Optional: an existing TwelveLabs index to use. It must have a Marengo model with the "visual"
# model option ("audio" too for spoken-word search). Leave blank and the app creates one
# (marengo3.0, visual+audio, thumbnails) on the first upload and reuses it from then on.
TWELVELABS_INDEX_ID=
# Relative paths resolve from the project root. Keep outside public/.
DATA_DIR=./data
# Optional: lower the upload limit (in MB). The provider maximum is 4000 MB.
MAX_UPLOAD_MB=

# --- Hosted session mode (Vercel) only --------------------------------------
# Set these in Vercel → Settings → Environment Variables, not here.
# The sign-in password, at least 12 characters.
APP_PASSWORD=
# Authorizes the daily cleanup job (Vercel Cron sends it as "Authorization: Bearer ...").
# At least 16 random characters, e.g. from: openssl rand -hex 32
CRON_SECRET=
# Added by Vercel when you connect the private Blob store (do not type them in):
#   BLOB_STORE_ID + BLOB_WEBHOOK_PUBLIC_KEY (OIDC), or BLOB_READ_WRITE_TOKEN
# APP_MODE=session runs hosted mode locally for testing (in-memory store, never on Vercel).
